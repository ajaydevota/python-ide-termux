<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface"
        android:paddingStart="6dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/backBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="&#8249;"
            android:textColor="@color/ink"
            android:textSize="26sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Termux"
            android:textColor="@color/ink"
            android:textStyle="bold"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface"
        android:padding="8dp">

        <EditText
            android:id="@+id/cmdInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="command (jaise: pkg install python)"
            android:textColorHint="@color/ink_dim"
            android:textColor="@color/ink"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:inputType="text"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/runCmdBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="&#9654; चलाएँ"
            android:textColor="@color/black"
            android:backgroundTint="@color/run" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/console_bg">

        <TextView
            android:id="@+id/logView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/ink"
            android:textSize="12sp"
            android:padding="12dp"
            android:textIsSelectable="true" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/surface"
        android:padding="8dp">

        <Button
            android:id="@+id/chipUpdate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="pkg update"
            android:textSize="11sp"
            android:minWidth="0dp" />

        <Button
            android:id="@+id/chipPython"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="pkg install python"
            android:textSize="11sp"
            android:minWidth="0dp" />

        <Button
            android:id="@+id/chipNumpy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="pip install numpy"
            android:textSize="11sp"
            android:minWidth="0dp" />

        <Button
            android:id="@+id/chipVer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="python --version"
            android:textSize="11sp"
            android:minWidth="0dp" />
    </LinearLayout>
</LinearLayout>
